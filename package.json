{
  "name": "leave-app-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w employee-portal\" \"npm run dev -w manager-portal\"",
    "build": "npm run build --workspaces --if-present",
    "db:push": "npm run db:push --workspace=@leave-app/database"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
