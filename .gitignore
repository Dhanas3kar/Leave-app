# ==============================================================================
# 1. DEPENDENCIES & PACKAGE MANAGERS
# ==============================================================================
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/
package-lock.json
pnpm-lock.yaml
yarn.lock

# ==============================================================================
# 2. NEXT.JS & BUILD OUTPUTS
# ==============================================================================
.next/
out/
build/
dist/
.turbo/

# ==============================================================================
# 3. MONOREPO / WORKSPACE SPECIFICS
# ==============================================================================
apps/*/.next
apps/*/out
apps/*/build
apps/*/dist
packages/*/.next
packages/*/build
packages/*/dist

# ==============================================================================
# 4. HARDENED SECURITY (Secrets, Keys, Certificates)
# ==============================================================================
# Block all environment files completely
.env
.env.*
!.env.example
!.env.template

# Block private keys, certificates, and credentials
*.pem
*.key
*.pub
*.pfx
*.p12
*.crt
*.csr
.secrets/
secrets.json
service-account.json

# ==============================================================================
# 5. DATABASES & ORMS (Prisma / SQLite)
# ==============================================================================
*.db
*.db-journal
*.sqlite
*.sqlite3
/prisma/migrations/**/*.sql
# Un-comment below if you want to force migration SQL tracking but ignore local db
# !/prisma/migrations/**/*.sql

# ==============================================================================
# 6. TESTING & REPORTS (Playwright / Cypress / Jest)
# ==============================================================================
test-results/
playwright-report/
blob-report/
.playwright/
cypress/videos/
cypress/screenshots/
coverage/
.nyc_output/

# ==============================================================================
# 7. IDE, EDITORS, & OS (Local User Configs)
# ==============================================================================
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# VS Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# WebStorm / IntelliJ / JetBrains
.idea/
*.iml
*.iws

# ==============================================================================
# 8. DEBUG & DIAGNOSTICS
# ==============================================================================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.tsbuildinfo
next-env.d.ts

# ==============================================================================
# 9. CLOUD & DEPLOYMENT (Vercel / AWS / Docker)
# ==============================================================================
.vercel
.aws/
.serverless/
